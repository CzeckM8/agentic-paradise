# Smallville LLM Configuration
# Copy this file to .env and fill in your values

# Google AI Studio API Key (get free tier at ai.google.dev)
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Optional: Set LLM provider (google_ai or ollama)
LLM_PROVIDER=google_ai

# Optional: Override model name
# Examples: gemini-2.5-flash-lite, gemini-3.1-flash-lite-preview
LLM_MODEL=gemini-2.5-flash-lite

# Optional: Server port (default 8080)
SERVER_PORT=8080
